rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Replace with the User UID of the admin user (Firebase Console > Authentication > Users).
    // A UID cannot be claimed by anyone else, unlike an email address.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.auth.uid == '4FSqW048fSdUFMQZJ1OJVp7GLob2';
    }

    function signedIn() {
      return request.auth != null;
    }

    function storeOpen() {
      let path = /databases/$(database)/documents/config/store;
      return !exists(path) || get(path).data.get('open', true) == true;
    }

    function deliveryOn() {
      let path = /databases/$(database)/documents/config/store;
      return exists(path) && get(path).data.get('del', false) == true;
    }

    // Cafe is at 12.847503, 80.196458. Flat-earth distance in km (1 deg lat = 110.63 km, 1 deg lng = 108.55 km here).
    function shopKm(d) {
      let dy = (d.lat - 12.847503) * 110.63;
      let dx = (d.lng - 80.196458) * 108.55;
      return math.sqrt(dx * dx + dy * dy);
    }

    // Delivery fee: free to 5 km, Rs 15/km from 5 to 10 km, Rs 20/km beyond 10 km. The client rounds to whole rupees, so allow Rs 2 of slack.
    function minFee(km) {
      return km > 10 ? 75 + 20 * (km - 10) - 2 : (km > 5 ? 15 * (km - 5) - 2 : 0);
    }

    // Optional 4-digit delivery code (orders placed before the feature, or by a cached page, have none and are closed manually).
    function validOtp(d) {
      return !('otp' in d) || (d.otp is string && d.otp.matches('^[0-9]{4}$'));
    }

    // Farthest delivery is 15 km (15.1 allows for the flat-earth approximation).
    function validDelivery(d) {
      return deliveryOn()
        && d.keys().hasAll(['addr', 'lat', 'lng', 'fee'])
        && validOtp(d)
        && d.addr is string && d.addr.size() >= 8 && d.addr.size() <= 200 && !d.addr.matches('.*[<>].*')
        && (d.lat is float || d.lat is int) && (d.lng is float || d.lng is int)
        && d.lat >= -90 && d.lat <= 90 && d.lng >= -180 && d.lng <= 180
        && shopKm(d) <= 15.1
        && d.fee is int && d.fee >= 0 && d.fee <= 500 && d.fee >= minFee(shopKm(d))
        && d.p.matches('^[+0-9]{10,16}$');
    }

    function validOrder(d, id) {
      return d.keys().hasOnly(['id', 'n', 'p', 'em', 'nt', 'it', 'total', 'pay', 'svc', 'tbl', 'uid', 'at', 'addr', 'lat', 'lng', 'fee', 'otp'])
        && d.keys().hasAll(['id', 'n', 'p', 'it', 'total', 'pay', 'svc', 'uid', 'at'])
        && d.id == id
        && d.uid == request.auth.uid
        && d.at == request.time
        && d.n is string && d.n.size() > 0 && d.n.size() <= 40 && !d.n.matches('.*[<>].*')
        && d.p is string && d.p.matches('^[+0-9]{7,16}$')
        && (!('em' in d) || (d.em is string && d.em.size() <= 80 && d.em.matches('^[a-z0-9._%+-]+@[a-z0-9.-]+\\.[a-z]{2,}$')))
        && (!('nt' in d) || (d.nt is string && d.nt.size() <= 140 && !d.nt.matches('.*[<>].*')))
        && (!('tbl' in d) || (d.tbl is string && d.tbl.size() <= 8 && !d.tbl.matches('.*[<>].*')))
        && d.it is list && d.it.size() >= 1 && d.it.size() <= 60
        && d.total is int && d.total > 0 && d.total <= 100000
        && d.pay in ['upi', 'counter']
        && d.svc in ['dine', 'take', 'deliver']
        && (d.svc == 'deliver' ? validDelivery(d) : !(('addr' in d) || ('lat' in d) || ('lng' in d) || ('fee' in d) || ('otp' in d)));
    }

    // Private: only the admin can read orders. Customers can only create them, and only while the store is open.
    match /orders/{id} {
      allow read: if isAdmin();
      allow create: if signedIn() && storeOpen() && id.matches('LH-[A-Z0-9]{6,10}') && validOrder(request.resource.data, id);
      allow update, delete: if isAdmin();
    }

    // Readable by id only (no listing): lets a customer follow their order without exposing personal data.
    match /status/{id} {
      allow get: if signedIn();
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // Instant emails: mail/{id} records which emails were sent; mailq/{id}_{key} is a create-only claim so that
    // when several admin devices are open only one of them sends a given email.
    match /mail/{id} {
      allow read, write: if isAdmin();
    }
    match /mailq/{id} {
      allow read, delete: if isAdmin();
      allow create: if isAdmin() && id.matches('LH-[A-Z0-9]{6,10}_[pcorx]');
      allow update: if false;
    }

    // Open/closed, sold-out items, prep time and banner.
    match /config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
